<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_chamatech" model="ir.module.category">
            <field name="name">ChamaTech Management</field>
            <field name="description">Access control groups for the savings and credit group platform.</field>
        </record>
        
        <record id="group_chamatech_user" model="res.groups">
            <field name="name">Base User (Welfare/Member)</field>
            <field name="category_id" ref="module_category_chamatech"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_chamatech_manager" model="res.groups">
            <field name="name">Manager (Secretary/Treasurer)</field>
            <field name="category_id" ref="module_category_chamatech"/>
            <field name="implied_ids" eval="[(4, ref('group_chamatech_user')), (4, ref('account.group_account_invoice'))]"/>
        </record>

        <record id="group_chamatech_admin" model="res.groups">
            <field name="name">System Administrator (Chairperson)</field>
            <field name="category_id" ref="module_category_chamatech"/>
            <field name="implied_ids" eval="[(4, ref('group_chamatech_manager')), (4, ref('account.group_account_manager'))]"/>
        </record>
    </data>
</odoo>

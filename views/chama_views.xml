<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="chamatech_list" model="ir.ui.view">
      <field name="name">chamatech_list</field> 
      <field name="model">chamatech.chamatech</field>
      <field name="arch" type="xml">
        <list default_order="amount desc" decoration-bf="amount &gt; 1000">
          <field name="member_id"/>
          <field name="amount" sum="Total Contributions"/>
          <field name="description"/>
          <field name="status" widget="badge" decoration-info="status == 'in_progress'" decoration-success="status == 'goal_reached'"/>
          <field name="date" />
        </list>
      </field>
    </record>

    <record id="chamatech_pivot" model="ir.ui.view">
      <field name="name">chamatech_pivot</field>
      <field name="model">chamatech.chamatech</field>
      <field name="arch" type="xml">
        <pivot string="Financial Analysis" disable_linking="true">
          <field name="member_id" type="row" />
          <field name="amount" type="measure" />
        </pivot>
      </field>
    </record>

    <record id="chamatech_kanban" model="ir.ui.view">
      <field name="name">chamatech_kanban</field>
      <field name="model">chamatech.chamatech</field>
      <field name="arch" type="xml">
        <kanban default_group_by="status">
          <field name="member_id" />
          <field name="amount" />
          <field name="status" />
          <templates>
            <t t-name="card">
              <div class="oe_kanban_global_click">
                <div class="o_kanban_record_top">
                  <strong>
                    <field name="member_id" />
                  </strong>
                </div>
                <div class="oe_kanban_details">
                  <span>Amount: </span> <field name="amount" />
                </div>
                <div class="o_kanban_record_bottom">
                  <span>Status: </span> <field name="status" />
                </div>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <record id="chamatech_form" model="ir.ui.view">
      <field name="name">chamatech.form</field>
      <field name="model">chamatech.chamatech</field>
      <field name="arch" type="xml">
        <form> 
          <header>
            <field name="status" widget="statusbar" statusbar_visible="in_progress,goal_reached"/>
          </header>
          <sheet> 
            <group>
                <group>
                    <field name="member_id"/>
                    <field name="amount"/>
                </group>
                <group>
                    <field name="date" />
                    <field name="status" readonly="1" force_save="1"/>
                </group>
            </group>
            <group>
                <field name="description"/>
            </group>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>

    <record id="chamatech_action_window" model="ir.actions.act_window">
      <field name="name">Chama Tech</field>
      <field name="res_model">chamatech.chamatech</field>
      <field name="view_mode">list,form,kanban,pivot,graph</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Add a new record
        </p>
        <p>
          Welcome to Chama Tech, make your first contribution.
        </p>
      </field>
    </record>
  </data>
</odoo>
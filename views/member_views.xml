<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="chamamember_list" model="ir.ui.view">
            <field name="name">chamatech.member.list</field>
            <field name="model">chamatech.member</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="phone" />
                    <field name="role_id" />
                    <field name="date_joined" />
                    <field name="total_contributions" sum="Grand Total" decoration-bf="1"/>
                </list>
            </field>
        </record>

        <record id="member_form" model="ir.ui.view">
            <field name="name">chamatech.member.form</field>
            <field name="model">chamatech.member</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group string="Basic Information">
                                <field name="partner_id" widget="many2one_avatar" context="{'show_address': 1}" />
                                <field name="phone" />
                                <field name="role_id" />
                            </group>
                            <group string="Membership Status">
                                <field name="date_joined" />
                                <field name="date_left" invisible="not date_left" />
                                <field name="active" widget="boolean_toggle" />
                                <field name="total_contributions" readonly="1" decoration-bf="1" />
                            </group>
                        </group>

                        <notebook>
                            <page string="Contributions" name="contributions">
                                <field name="contribution_ids">
                                    <list editable="bottom" decoration-success="state == 'confirmed'" decoration-info="state == 'draft'">
                                        <field name="date"/>
                                        <field name="amount" sum="Total"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Role History" name="history">
                                <field name="history_ids" readonly="1">
                                    <list create="false" edit="false">
                                        <field name="role_id" />
                                        <field name="date_assigned" />
                                        <field name="date_resigned" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_member_filter" model="ir.ui.view">
            <field name="name">chamatech.member.search</field>
            <field name="model">chamatech.member</field>
            <field name="arch" type="xml">
                <search string="Search Members">
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="role_id"/>
                    <filter string="Archived" name="is_inactive" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="chamamember_action_window" model="ir.actions.act_window">
            <field name="name">Chama Member</field>
            <field name="res_model">chamatech.member</field>
            <field name="view_mode">list,form,kanban,pivot,graph</field>
            <field name="search_view_id" ref="view_member_filter"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first member
                </p>
                <p>
                    Add the people in your group here so you can start tracking their contributions and roles.
                </p>
            </field>
        </record>
    </data>   
</odoo>